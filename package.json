{
  "name": "otonom-site",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node app.js",
    "postinstall": "nuxt prepare",
    "test:tco": "esbuild test/tco.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/tco.test.mjs --log-level=error && node node_modules/.cache/tco.test.mjs",
    "test:bornes": "esbuild test/bornes-chr.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/bornes.test.mjs --log-level=error && node node_modules/.cache/bornes.test.mjs",
    "test:recharge": "esbuild test/recharge-collaborateur.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/recharge.test.mjs --log-level=error && node node_modules/.cache/recharge.test.mjs"
  },
  "dependencies": {
    "mysql2": "^3.22.6",
    "nodemailer": "^9.0.3",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "^0.5.29",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  }
}
